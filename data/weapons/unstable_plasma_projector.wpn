{
	"id":"volatile_plasma_bolter",  # this id must match what's in the spreadsheet
	"specClass":"projectile",
	"type":"ENERGY",
	"mountTypeOverride":"ENERGY",
	"size":"SMALL",
	"turretSprite":"graphics/tidal/weapons/unstable_plasma_bolter.png",
	"turretGlowSprite":"graphics/tidal/weapons/unstable_plasma_bolter_glow.png",
	"hardpointSprite":"graphics/tidal/weapons/unstable_plasma_bolter_hardpoint.png",
	"hardpointGlowSprite":"graphics/tidal/weapons/unstable_plasma_bolter_hardpoint_glow.png",
	"glowColor":[255,10,50,255],
	"turretOffsets":[6, 0], #15
	"turretAngleOffsets":[0],
	"hardpointOffsets":[8, 0],#15
	"hardpointAngleOffsets":[0],
	"barrelMode":"ALTERNATING", # or LINKED.  whether barrels fire at the same time or alternate.
	"unaffectedByProjectileSpeedBonuses":true,
	#"animationType":"GLOW",
	"animationType":"GLOW_AND_FLASH",
